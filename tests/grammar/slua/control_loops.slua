local i = 0
while i < 10 do
    i += 1
end

repeat
    i -= 1
until i <= 0

for n = 1, 10 do
    print(n)
end

for n = 1, 10, 2 do
    print(n)
end

for k, v in pairs({}) do
    print(k, v)
end

